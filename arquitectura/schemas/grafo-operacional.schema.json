{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:popayan-planetario:schema:grafo-operacional",
  "title": "Grafo operacional de Popayán Planetario",
  "description": "Nodos, aristas, servicios de despliegue, restricciones de aislamiento y telemetría. Ver arquitectura/grafo-operacional.json.",
  "type": "object",
  "required": [
    "proyecto",
    "documento",
    "version",
    "fecha",
    "estado",
    "alineado_con",
    "nucleo_organizacional",
    "escala",
    "modelo_de_carga",
    "servicios_de_despliegue",
    "nodos",
    "aristas",
    "restricciones_aislamiento",
    "telemetria"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "proyecto": { "const": "Popayán Planetario" },
    "documento": { "$ref": "#/$defs/texto" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "fecha": { "$ref": "#/$defs/fecha" },
    "estado": { "$ref": "#/$defs/texto" },
    "alineado_con": { "type": "string", "pattern": "^arquitectura/kernel-durable\\.json \\(\\d+\\.\\d+\\.\\d+-DURABLE-KERNEL\\)$" },
    "nucleo_organizacional": {
      "type": "object",
      "required": ["id", "regla_de_bloqueo"],
      "properties": {
        "id": { "const": "N0" },
        "regla_de_bloqueo": { "$ref": "#/$defs/texto" }
      },
      "additionalProperties": false
    },
    "escala": {
      "type": "object",
      "required": ["marcas", "sedes_estimadas", "usuarios_concurrentes_pico", "requisito_de_capacidad", "galaxias", "fase_mvp", "lanzamiento_oficial"],
      "properties": {
        "marcas": { "type": "integer", "minimum": 1 },
        "sedes_estimadas": { "type": "integer", "minimum": 1 },
        "usuarios_concurrentes_pico": { "type": "integer", "minimum": 1 },
        "requisito_de_capacidad": { "$ref": "#/$defs/texto" },
        "galaxias": { "type": "integer", "minimum": 1 },
        "fase_mvp": { "$ref": "#/$defs/fecha" },
        "lanzamiento_oficial": { "$ref": "#/$defs/fecha" }
      },
      "additionalProperties": false
    },
    "modelo_de_carga": {
      "type": "object",
      "required": ["archivo", "escenario_de_dimensionamiento", "nota"],
      "properties": {
        "archivo": { "const": "arquitectura/modelo-de-carga.json" },
        "escenario_de_dimensionamiento": { "$ref": "#/$defs/texto" },
        "nota": { "$ref": "#/$defs/texto" }
      },
      "additionalProperties": false
    },
    "servicios_de_despliegue": {
      "type": "object",
      "required": ["fuente"],
      "properties": { "fuente": { "$ref": "#/$defs/texto" } },
      "additionalProperties": {
        "type": "object",
        "required": ["replicas"],
        "properties": { "replicas": { "type": "integer", "minimum": 1 } },
        "additionalProperties": false
      }
    },
    "nodos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nodo" } },
    "aristas": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/arista" } },
    "restricciones_aislamiento": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "regla", "mecanismo", "verificacion"],
        "properties": {
          "id": { "type": "string", "pattern": "^R\\d{2}$" },
          "regla": { "$ref": "#/$defs/texto" },
          "mecanismo": { "$ref": "#/$defs/texto" },
          "verificacion": { "$ref": "#/$defs/texto" }
        },
        "additionalProperties": false
      }
    },
    "telemetria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nombre", "objeto", "formula", "umbral"],
        "properties": {
          "id": { "type": "string", "pattern": "^T\\d{2}$" },
          "nombre": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
          "objeto": { "$ref": "#/$defs/texto" },
          "formula": { "$ref": "#/$defs/texto" },
          "umbral": { "$ref": "#/$defs/texto" }
        },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": {
    "^cambios_\\d+_\\d+$": { "$ref": "#/$defs/texto" }
  },
  "additionalProperties": false,
  "$defs": {
    "texto": { "type": "string", "minLength": 1 },
    "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "id_nodo": { "type": "string", "pattern": "^(N0|[GAPDX]\\d{1,2})$" },
    "nodo": {
      "type": "object",
      "required": ["id", "nombre", "tipo", "capa", "gobernado_por", "cardinalidad", "capacidad", "fase", "descripcion"],
      "properties": {
        "id": { "$ref": "#/$defs/id_nodo" },
        "nombre": { "$ref": "#/$defs/texto" },
        "tipo": { "enum": ["nucleo", "gobierno", "actor", "tenant", "servicio", "datos", "externo"] },
        "capa": { "enum": ["organizacional", "demanda", "oferta", "plataforma", "datos", "externa"] },
        "gobernado_por": { "anyOf": [{ "$ref": "#/$defs/id_nodo" }, { "type": "null" }] },
        "cardinalidad": { "type": "integer", "minimum": 1 },
        "capacidad": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/capacidad" }] },
        "fase": { "enum": ["construccion", "mvp", "fase_2"] },
        "descripcion": { "$ref": "#/$defs/texto" }
      },
      "additionalProperties": false
    },
    "capacidad": {
      "description": "Tres formas excluyentes: valor fijo, capacidad por réplica de un servicio, o nivel de cuenta de Anthropic.",
      "oneOf": [
        {
          "type": "object",
          "required": ["mu_por_s", "base"],
          "properties": {
            "mu_por_s": { "type": "number", "exclusiveMinimum": 0 },
            "por_instancia": { "type": "boolean" },
            "base": { "$ref": "#/$defs/texto" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mu_por_replica", "servicio", "base"],
          "properties": {
            "mu_por_replica": { "type": "number", "exclusiveMinimum": 0 },
            "servicio": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
            "base": { "$ref": "#/$defs/texto" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["nivel_anthropic", "base"],
          "properties": {
            "nivel_anthropic": { "enum": ["Start", "Build", "Scale"] },
            "base": { "$ref": "#/$defs/texto" }
          },
          "additionalProperties": false
        }
      ]
    },
    "arista": {
      "type": "object",
      "required": ["id", "origen", "destino", "tipo", "sincronia", "peso", "clave_particion", "idempotente", "alcance", "respaldo", "ruta_pedido", "descripcion"],
      "properties": {
        "id": { "type": "string", "pattern": "^E\\d{2}$" },
        "origen": { "$ref": "#/$defs/id_nodo" },
        "destino": { "$ref": "#/$defs/id_nodo" },
        "tipo": { "enum": ["control", "datos", "evento", "mensaje", "pago", "solicitud"] },
        "sincronia": { "enum": ["sincrona", "asincrona"] },
        "peso": {
          "type": "object",
          "required": ["latencia_p95_ms", "friccion_media_s", "criticidad"],
          "properties": {
            "latencia_p95_ms": { "type": "number", "minimum": 0 },
            "friccion_media_s": { "type": "number", "minimum": 0 },
            "criticidad": { "type": "integer", "minimum": 1, "maximum": 5 }
          },
          "additionalProperties": false
        },
        "clave_particion": { "anyOf": [{ "$ref": "#/$defs/texto" }, { "type": "null" }] },
        "idempotente": { "type": "boolean" },
        "alcance": { "enum": ["global", "marca", "misma_marca", "usuario"] },
        "respaldo": { "anyOf": [{ "$ref": "#/$defs/texto" }, { "type": "null" }] },
        "ruta_pedido": { "type": "boolean" },
        "descripcion": { "$ref": "#/$defs/texto" }
      },
      "additionalProperties": false
    }
  }
}
